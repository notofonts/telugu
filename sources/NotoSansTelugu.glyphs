    sub vatelu uvowelsigntelu varasubscripttelu' by rasubscriptlowtelu;
    sub vatelu uuvowelsigntelu varasubscripttelu' by rasubscriptlowtelu;


    sub jatelu uuvowelsigntelu by juuvoweltelu;
    sub jatelu uvowelsigntelu by juvoweltelu;
    sub patelu uuvowelsigntelu by puuvoweltelu;
    sub patelu uvowelsigntelu by puvoweltelu;
    sub phatelu uuvowelsigntelu by phuuvoweltelu;
