{
code = "    sub @class14 ailengthmarktelu' lookup LengthMarkLigature tasubscripttelu';
    sub @class14 ailengthmarktelu' lookup LengthMarkLigature @class15';
    sub @class14 tasubscripttelu' lookup LengthMarkLigature rapostscripttelu';
# In a -tra conjunct where we don't apply the above ligature, such as ర్త్ర్, turn all
# ra ligatures into one which fits snugly around the ta:
lookup TaRaConjunct {
	sub tasubscriptnarrowtelu @RaSubscripts' by barasubscripttelu; # This happens to be a good width
} TaRaConjunct;

