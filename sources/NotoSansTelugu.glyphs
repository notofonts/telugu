# Swap lvocalic/llvocalic + subscript for anchoring (#17)
lookup LVocalicSwap {
    sub lvocalicvowelsigntelu' lookup DropVocalicVowel lookup AddLAfter @Level1Subscripts;
    sub llvocalicvowelsigntelu' lookup DropVocalicVowel lookup AddLLAfter @Level1Subscripts;
} LVocalicSwap;

