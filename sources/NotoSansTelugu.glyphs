    sub dzatelu uuvowelsigntelu by dzuuvoweltelu;
    sub dzatelu uvowelsigntelu by dzuvoweltelu;

lookup ChainedContextualGSUB21 {
	# This is horrible magic, and I'm sorry. The \"make UI\" script rewrites the GSUB code,
    # substituting \"telu\" with \"UItelu\". So without the following line, the ignore rule
    # will actually fire on a UI build even though the glyphs that the shaper sees are
    # actually \"jasubscriptUItelu nyasubscriptUItelu\". So we put in a more explicit
    # line which gets fired first.
    sub jasubscriptUItelu nyasubscriptUItelu' lookup MakeSpacing;
    ignore sub jasubscripttelu nyasubscripttelu'; # We support a conjunct here!

    sub @class19 @class18' lookup MakeSpacing;
    sub [ghaivoweltelu jhaivoweltelu maivoweltelu yaivoweltelu] @class18' lookup MakeSpacing;
    sub @class19 @class21' lookup MakeSpacing;
    sub @class19 tarasubscriptligtelu' lookup KickRaToPost;
    sub [ghaivoweltelu jhaivoweltelu maivoweltelu yaivoweltelu] tarasubscriptligtelu' lookup KickRaToPost;
} ChainedContextualGSUB21;

lookup ChainedContextualGSUB23 {
    sub @class25 @class24' lookup MakeSpacing;
    sub [tasubscripttelu tasubscriptnarrowtelu tasubscriptwidetelu tasubscriptlowtelu] @class24' lookup MakeSpacing;
    sub [tasubscripttelu tasubscriptnarrowtelu tasubscriptwidetelu tasubscriptlowtelu] [rvocalicvowelsigntelu rrvocalicvowelsigntelu]' lookup MakeSpacing;
} ChainedContextualGSUB23;

lookup ChainedContextualGSUB25 {
    sub @class28 @class29 @class27' lookup MakeNonspacing;
    sub [kassaavoweltelu kassovoweltelu kassoovoweltelu kassauvoweltelu] @class27' lookup MakeNonspacing;
} ChainedContextualGSUB25;

lookup ContextualGSUB27 {
    sub @class31' lookup RemoveSsa nnasubscripttelu.spacing' lookup AddSsa;
} ContextualGSUB27;

lookup ContextualGSUB28 {
    sub kassatelu' lookup RemoveSsa uvowelsigntelu' nnasubscripttelu' lookup AddSsa;
